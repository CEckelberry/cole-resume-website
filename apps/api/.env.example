# API service environment template — copy to apps/api/.env for local dev.

# --- runtime ---
PORT=8080
ENVIRONMENT=local           # local | staging | production
LOG_LEVEL=debug             # debug | info | warn | error

# --- database (required when ENVIRONMENT=production) ---
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable

# --- secrets used in later phases ---
GITHUB_TOKEN=               # PAT (read:user, public_repo) for /api/activity
DISCORD_WEBHOOK_URL=        # optional, contact-form notifications

# --- build metadata (CI overrides these) ---
BUILD_SHA=dev
VERSION=dev
